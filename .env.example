# OSM Edit MCP — safe local configuration

# Development is the default. Production is a deliberate separate profile.
OSM_USE_DEV_API=true
OSM_DEV_API_BASE=https://api06.dev.openstreetmap.org/api/0.6
OSM_API_BASE=https://api.openstreetmap.org/api/0.6

# Register separate OAuth applications on dev and production OSM. The only
# scopes used are read_prefs and write_api. Tokens are stored in the OS keyring.
OSM_DEV_CLIENT_ID=your_dev_client_id
OSM_DEV_CLIENT_SECRET=your_dev_client_secret
OSM_DEV_REDIRECT_URI=http://localhost:8080/callback

# OSM_PROD_CLIENT_ID=your_production_client_id
# OSM_PROD_CLIENT_SECRET=your_production_client_secret
# OSM_PROD_REDIRECT_URI=http://localhost:8080/callback

# Production-safe MCP profile. Raw node/way and natural-language direct-write
# tools are registered only when BOTH expert mode and the dev API are selected.
OSM_WRITE_PROFILE=safe
OSM_REQUIRE_HOST_CONFIRMATION=true
OSM_ALLOW_CUSTOM_API_BASE=false

# GPX files passed by path must remain below this directory. Inline GPX is also
# accepted. Long histories should be cropped with create_track_selection.
OSM_TRACK_IMPORT_DIR=./tracks
OSM_TRACK_MAX_FILE_BYTES=10485760
OSM_TRACK_MAX_POINTS=100000
OSM_TRACK_PROPOSAL_TTL_SECONDS=1800

# Durable proposal/idempotency state. Omit to use the per-user application-data
# directory outside the repository.
# OSM_PROPOSAL_DB_PATH=/absolute/private/path/proposals.sqlite3

# Optional privacy-preserving map matching. Only localhost URLs are accepted.
OSM_VALHALLA_URL=http://127.0.0.1:8002
OSM_VALHALLA_TIMEOUT_SECONDS=30

# Comma-separated providers whose terms explicitly permit OSM tracing. Keep
# empty unless you have checked the current OSM imagery/source guidance.
OSM_PERMITTED_IMAGERY_SOURCES=

MAX_CHANGESET_SIZE=50
DEFAULT_CHANGESET_COMMENT=Edited via OSM Edit MCP Server
DEFAULT_CHANGESET_SOURCE=survey
DEFAULT_CHANGESET_CREATED_BY=osm-edit-mcp/0.1.0

USE_KEYRING=true
ALLOW_PLAINTEXT_TOKEN_FILE=false
LOG_LEVEL=INFO
DEBUG=false

# The legacy HTTP wrapper is local/read-only. It has no default API key and
# direct write routes return HTTP 410.
# API_KEY=set_a_long_random_value_if_you_use_web_server
HOST=127.0.0.1
ALLOWED_ORIGINS=
