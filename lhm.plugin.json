      "name": "review_gpx_road_edit",
      "title": "Review a GPX road edit",
      "description": "Prepare a non-writing GPX-to-OSM road-edit proposal for explicit human review.",
      "arguments": [
        {
          "name": "gpx_path",
          "required": true
        },
        {
          "name": "edit_goal",
          "required": true
        }
      ]
    }
